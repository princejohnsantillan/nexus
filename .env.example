APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://nexus.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite locally (database/database.sqlite); Serverless Postgres on Laravel Cloud.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nexus
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The database queue and cache locally; Laravel Cloud's managed queue and Valkey (CACHE_STORE=redis) in production.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Nexus
# Nexus's own settings use the NEXUS_ prefix. Each feature lists its variables
# here, with a comment, in the same change that starts reading them.

# Outbound guard: requests may only go to public HTTPS addresses. Turning
# these off works only when APP_ENV=local, to test against a local MCP server.
NEXUS_BLOCK_PRIVATE_NETWORKS=true
NEXUS_REQUIRE_HTTPS=true

# Downstream servers: how long Nexus waits for a Connection's MCP server, in
# seconds. The connect timeout covers connecting and the handshake; the call
# timeout covers listing and calling tools, and stays under Laravel Cloud's
# 60-second limit for web requests.
NEXUS_DOWNSTREAM_CONNECT_TIMEOUT=10
NEXUS_DOWNSTREAM_CALL_TIMEOUT=55

# Limits for each user's account. Calls per minute apply to each credential a
# client uses to reach a Star, such as each of its tokens.
NEXUS_CONNECTIONS_PER_USER=25
NEXUS_STARS_PER_USER=10
NEXUS_TOKENS_PER_STAR=10
NEXUS_CALLS_PER_MINUTE=120

# GitHub sign-in: the GitHub OAuth app people sign in to Nexus with. Register it
# at https://github.com/settings/developers with the callback URL
# ${APP_URL}/auth/github/callback. It is separate from the GitHub connector's app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Connectors: the OAuth app this deployment registered for a gallery connector,
# so users can sign in to it without registering their own. Each connector
# reads its own pair, NEXUS_{KEY}_CLIENT_ID and NEXUS_{KEY}_CLIENT_SECRET, named
# after its file in resources/connectors (dashes become underscores). GitHub's
# app is separate from the GitHub sign-in app above. Leave them empty to let
# users connect GitHub with their own token.
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=

# Dev sign-in: sign in as a seeded user without a GitHub OAuth app. Only works
# when APP_ENV=local; run `php artisan db:seed` to create the users.
NEXUS_DEV_SIGN_IN=false

# Credential encryption. Each user's credentials are encrypted with their own
# data key, which is stored wrapped by this master key (32 random bytes,
# base64-encoded). Generate one with `php artisan nexus:master-key`, which
# prints a new key and writes no files. Keep it apart from APP_KEY and the
# database, and never lose or change it: without it every stored credential
# is unreadable. Nexus refuses to encrypt or decrypt without a valid key.
NEXUS_MASTER_KEY=
