APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Sign-in providers (callback: ${APP_URL}/auth/{github,google}/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credential encryption: "local" wraps per-user keys with NEXUS_MASTER_KEY,
# "kms" wraps them with an AWS KMS key. Generate a master key with
# `php artisan nexus:master-key`. Keep it separate from APP_KEY.
NEXUS_KEY_DRIVER=local
NEXUS_MASTER_KEY=
NEXUS_KMS_KEY_ID=

# Outbound guard. Disable only to test against servers on localhost.
NEXUS_BLOCK_PRIVATE_NETWORKS=true
NEXUS_REQUIRE_HTTPS=true

# OAuth apps for connectors whose servers don't let clients register
# themselves. Callback: ${APP_URL}/oauth/callback. Leave empty to have each
# user bring their own app.
NEXUS_SLACK_CLIENT_ID=
NEXUS_SLACK_CLIENT_SECRET=
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=
NEXUS_GMAIL_CLIENT_ID=
NEXUS_GMAIL_CLIENT_SECRET=

# Limits per account
NEXUS_MAX_VAULTS=10
NEXUS_MAX_CONNECTIONS=25
NEXUS_MAX_TOKENS_PER_VAULT=10
NEXUS_CALLS_PER_MINUTE=120
NEXUS_DOWNSTREAM_TIMEOUT=120
NEXUS_LOG_RETENTION_DAYS=30
