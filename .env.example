APP_NAME=Nexus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://nexus.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite locally (database/database.sqlite); Serverless Postgres on Laravel Cloud.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=nexus
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# The database queue and cache locally; Laravel Cloud's managed queue and Valkey (CACHE_STORE=redis) in production.
QUEUE_CONNECTION=database
CACHE_STORE=database
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail carries the one-time codes for signing in with an email address. Locally
# the log mailer writes each email to storage/logs/mail.log (its own channel,
# MAIL_LOG_CHANNEL), never to laravel.log. In production, email sign-in is
# hidden until MAIL_MAILER is a mailer that delivers (not log or array).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Nexus
# Nexus's own settings use the NEXUS_ prefix. Each feature lists its variables
# here, with a comment, in the same change that starts reading them.

# Outbound guard: requests may only go to public HTTPS addresses. Turning
# these off works only when APP_ENV=local, to test against a local MCP server.
NEXUS_BLOCK_PRIVATE_NETWORKS=true
NEXUS_REQUIRE_HTTPS=true

# Downstream servers: how long Nexus waits for a Connection's MCP server, in
# seconds. The connect timeout covers connecting and the handshake; the call
# timeout covers listing and calling tools, and is also the most one session's
# requests take altogether, handshake included, so it stays under Laravel
# Cloud's 60-second limit for web requests.
NEXUS_DOWNSTREAM_CONNECT_TIMEOUT=10
NEXUS_DOWNSTREAM_CALL_TIMEOUT=55

# Catalogs: every Connection's tools are refreshed on the queue once a day, and
# when a Star lists its tools or prompts from a catalog older than this many
# minutes (6 hours).
NEXUS_CATALOG_STALE_AFTER_MINUTES=360

# Limits for each user's account. Calls per minute apply to each credential a
# client uses to reach a Star, such as each of its tokens. OAuth client
# registrations with Stars in OAuth mode are limited per hour per IP address.
# Email codes (to sign in, or to add an address in Settings) are limited per
# hour for each address and for each IP address, with a minute between two
# codes to the same address.
NEXUS_TOKENS_PER_STAR=10
NEXUS_CALLS_PER_MINUTE=120
NEXUS_OAUTH_REGISTRATIONS_PER_HOUR=20
NEXUS_EMAIL_CODES_PER_ADDRESS_PER_HOUR=5
NEXUS_EMAIL_CODES_PER_IP_PER_HOUR=20

# Plans: what the Free plan includes. Pro has no limits. Limits stop adding
# only; nothing over a limit is deleted or disabled. Lower them to try the
# limits locally.
NEXUS_FREE_STARS=2
NEXUS_FREE_CONNECTIONS=10
NEXUS_FREE_TOOL_CALLS_PER_WEEK=3000

# Activity: how many days each activity entry is kept. A daily scheduled prune
# removes older entries.
NEXUS_ACTIVITY_RETENTION_DAYS=30

# Contact and legal pages: the address the Terms, Privacy and Refund pages give
# for questions, refunds and privacy requests. The pages say they're a draft
# until NEXUS_LEGAL_REVIEWED=true, once the owner has reviewed them with counsel.
NEXUS_CONTACT_EMAIL=hello@example.com
NEXUS_LEGAL_REVIEWED=false

# Payments: Pro is paid on PayMongo's hosted checkout. Take the keys from the
# PayMongo dashboard (Developers → API keys): sk_test_/pk_test_ for test mode,
# sk_live_/pk_live_ for real payments. Payments are set up only once the
# secret key is set; without it the Upgrade page says so and nothing calls
# PayMongo. The webhook secret is the one PayMongo shows for Nexus's webhook.
# The payment methods checkout offers are PayMongo's names, comma-separated:
# card, gcash, paymaya (Maya), qrph (QR Ph), grab_pay.
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_PAYMENT_METHODS=card,gcash,paymaya,qrph

# GitHub sign-in: the GitHub OAuth app people sign in to Nexus with. Register it
# at https://github.com/settings/developers with the callback URL
# ${APP_URL}/auth/github/callback. It is separate from the GitHub connector's app.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google sign-in: an OAuth client ID of the "Web application" type, created at
# https://console.cloud.google.com/apis/credentials with the authorized redirect
# URI ${APP_URL}/auth/google/callback. Leave both empty to hide Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connectors: the OAuth app this deployment registered for a gallery connector,
# so users can sign in to it without registering their own. Each connector
# reads its own pair, NEXUS_{KEY}_CLIENT_ID and NEXUS_{KEY}_CLIENT_SECRET, named
# after its file in resources/connectors (dashes become underscores). GitHub's
# app is separate from the GitHub sign-in app above: register it with the
# callback URL ${APP_URL}/oauth/callback, which every Connection's sign-in
# shares. Leave them empty to let users connect GitHub with their own token or
# their own OAuth app. Notion and Linear need nothing: Nexus registers itself.
NEXUS_GITHUB_CLIENT_ID=
NEXUS_GITHUB_CLIENT_SECRET=

# Dev sign-in: sign in as a seeded user without a GitHub OAuth app. Only works
# when APP_ENV=local; run `php artisan db:seed` to create the users.
NEXUS_DEV_SIGN_IN=false

# Credential encryption. Each user's credentials are encrypted with their own
# data key, which is stored wrapped by this master key (32 random bytes,
# base64-encoded). Generate one with `php artisan nexus:master-key`, which
# prints a new key and writes no files. Keep it apart from APP_KEY and the
# database, and never lose or change it: without it every stored credential
# is unreadable. Nexus refuses to encrypt or decrypt without a valid key.
NEXUS_MASTER_KEY=

# OAuth to Nexus: Nexus is the OAuth authorization server for Stars in OAuth
# mode, and signs the access tokens it issues with this RSA key pair. Locally,
# `php artisan passport:keys` writes it to storage/oauth-private.key and
# storage/oauth-public.key and these stay empty. In production, put both PEM
# keys here instead, as secrets. Replacing them invalidates every access token
# issued so far, so clients have to renew theirs.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# The private-use URI schemes desktop clients may register as OAuth redirect
# URIs, besides HTTPS and loopback HTTP (comma-separated).
NEXUS_OAUTH_CUSTOM_SCHEMES=cursor,vscode,vscode-insiders,windsurf,zed
