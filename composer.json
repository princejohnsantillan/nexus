{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "princejohnsantillan/nexus",
    "type": "project",
    "description": "A multi-user remote MCP gateway: connect each MCP server once and expose it to every AI harness through Stars.",
    "keywords": [
        "laravel",
        "mcp",
        "livewire"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "aws/aws-sdk-php": "^3.399",
        "laravel/framework": "^13.34",
        "laravel/mcp": "^1.0",
        "laravel/passport": "^13.8",
        "laravel/socialite": "^5.31",
        "laravel/tinker": "^3.0",
        "livewire/blaze": "^1.0",
        "livewire/flux": "^2.20",
        "livewire/livewire": "^4.4"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "calebdw/larastan-livewire": "^2.5",
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.53",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-laravel": "^5.0",
        "rector/rector": "^2.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --force",
            "@php -r \"file_exists('storage/oauth-private.key') || passthru(escapeshellarg(PHP_BINARY).' artisan passport:keys');\"",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "qa": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan config:clear --ansi",
            "rector process --dry-run",
            "pint --parallel --test",
            "phpstan analyse --memory-limit=1G",
            "pest --parallel"
        ],
        "fix": [
            "rector process",
            "pint --parallel"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models --write",
            "pint app/Models"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts-descriptions": {
        "setup": "Install dependencies, create .env and the SQLite database, migrate, create the OAuth signing keys and build assets.",
        "qa": "Check everything without changing files: Rector (dry run), Pint (test), PHPStan, then Pest in parallel.",
        "fix": "Apply Rector, then Pint.",
        "ide-helper": "Regenerate the IDE helper files and write model docblocks into the models."
    }
}
